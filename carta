  originals.set(d, {
    name: d.querySelector('.dish-name')?.innerHTML || '',
    desc: d.querySelector('.dish-desc')?.innerHTML || ''
  });
});

function doSearch(q) {
  q = q.trim().toLowerCase();
  clearBtn.classList.toggle('visible', q.length > 0);

  let found = 0;
  dishes.forEach(d => {
    const haystack = (d.dataset.search || '') + ' ' + d.textContent.toLowerCase();
    const match = !q || haystack.includes(q);
    d.classList.toggle('hidden', !match);
    if (match) found++;

    // restore then highlight
    const orig = originals.get(d);
    const nameEl = d.querySelector('.dish-name');
    const descEl = d.querySelector('.dish-desc');
    if (nameEl) nameEl.innerHTML = orig.name;
    if (descEl) descEl.innerHTML = orig.desc;
    if (match && q) {
      [nameEl, descEl].forEach(el => {
        if (!el) return;
        const re = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')})`, 'gi');
        el.innerHTML = el.innerHTML.replace(re, '<mark>$1</mark>');
      });
    }
  });

  // hide empty sections
  sections.forEach(s => {
    const visible = [...s.querySelectorAll('.dish')].some(d => !d.classList.contains('hidden'));
    s.classList.toggle('empty-cat', !visible);
  });

  if (q) {
    countEl.textContent = found === 0
      ? (t[currentLang]?.search_none || 'Sin resultados')
      : `${found} ${found === 1 ? (t[currentLang]?.search_result || 'plato') : (t[currentLang]?.search_results || 'platos')}`;
    countEl.className = 'search-count ' + (found === 0 ? 'none' : 'found');
  } else {
    countEl.textContent = '';
    countEl.className = 'search-count';
  }
}

searchEl.addEventListener('input', () => doSearch(searchEl.value));
clearBtn.addEventListener('click', () => { searchEl.value = ''; doSearch(''); searchEl.focus(); });

