function applyLang(lang) {
  currentLang = lang;
  const d = t[lang] || t.es;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.getAttribute('data-i18n');
    if (d[k] !== undefined) el.textContent = d[k];
  });
  document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
    const k = el.getAttribute('data-i18n-placeholder');
    if (d[k]) el.placeholder = d[k];
  });
  searchEl.placeholder = d.search_ph || 'Buscar...';
  // re-run search to update count label
  if (searchEl.value) doSearch(searchEl.value);
  // refresh originals map after translation
  dishes.forEach(di => {
    originals.set(di, {
      name: di.querySelector('.dish-name')?.innerHTML || '',
      desc: di.querySelector('.dish-desc')?.innerHTML || ''
    });
  });
  try { localStorage.setItem('lang', lang); } catch(e){}
}

const saved = (() => { try { return localStorage.getItem('lang'); } catch(e){ return null; } })();
applyLang(saved || 'es');

document.querySelectorAll('.nav-lang button').forEach(btn =>
  btn.addEventListener('click', () => applyLang(btn.dataset.lang))
